; Engine configuration file. Prefer editing through Project Settings.
config_version=5

[application]
config/name="Cyberpunk: The Last Ascent"
config/description="Unofficial noncommercial fan-game concept. Milestone 00 foundation."
config/version="0.0.0"
run/main_scene="res://scenes/main/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=960
window/size/window_height_override=540
window/size/min_width=320
window/size/min_height=180
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[input]
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
look_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
look_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
jump_charge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
cyberware_primary={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325,"location":1)]
}
cyberware_secondary={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194326,"location":1)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
pause_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
retry_boss={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.07, 1)
